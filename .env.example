# --- Login Option 1: Email + Password ---
NAUKRI_EMAIL=your@email.com
NAUKRI_PASSWORD=yourpassword

# --- Login Option 2: Phone + OTP (leave EMAIL/PASSWORD blank to use this) ---
# NAUKRI_PHONE=9876543210

BASE_RESUME_PATH=./resume_base.pdf
RESUME_OUTPUT_DIR=~/.naukri-mcp/resumes
HEADLESS=true
REQUEST_DELAY_SECONDS=2
MAX_APPLICATIONS_PER_SESSION=50

# Scoring and tailoring config
MASTER_RESUME_YAML=~/.naukri-mcp/master_resume.yaml
MIN_MATCH_SCORE=0.50
TARGET_ATS_SCORE=0.70
MAX_TAILOR_ITERATIONS=3
SCORE_KEYWORD_WEIGHT=0.6
